        {
          "name": "Create listing with expired token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{expiredToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/listings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"crop\": \"Soybean\",\n  \"category\": \"Pulses\",\n  \"description\": \"Clean grain\",\n  \"quantity\": 20,\n  \"price\": 4500,\n  \"location\": \"Kolhapur\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Says session expired\", () => { const j = pm.response.json(); pm.expect(j.message).to.match(/expired/i); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b64 = o => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(o))).replace(/=+$/, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "const h = b64({alg: \"HS256\", typ: \"JWT\"}), p = b64({id: pm.environment.get(\"farmerId\"), role: \"farmer\", exp: Math.floor(Date.now() / 1000) - 60});",
                  "const s = CryptoJS.enc.Base64.stringify(CryptoJS.HmacSHA256(h + \".\" + p, pm.environment.get(\"jwtSecret\"))).replace(/=+$/, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "pm.environment.set(\"expiredToken\", h + \".\" + p + \".\" + s);"
                ]
              }
            }
          ]
        },
